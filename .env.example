# MayaCardio Bedside Data Pipeline Configuration
# Safe environment template - placeholders only, no secrets.

# Mock service connection
MOCK_HOST=127.0.0.1
MOCK_PORT=7100

# Cloud service endpoint
# Replace with your deployed cloud instance URL (e.g. https://mayacardio-cloud.onrender.com)
CLOUD_URL=http://127.0.0.1:8000

# Local device storage path
DEVICE_DB_PATH=mayacardio.db

# Cloud storage path
CLOUD_DB_PATH=mayacardio_cloud.db

# Sync & health probe timings (seconds)
PROBE_INTERVAL=1.0
PROBE_TIMEOUT=0.8
OUTBOX_BATCH_SIZE=2000
